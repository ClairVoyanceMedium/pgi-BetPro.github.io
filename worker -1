async function runScheduledScan(env) {
  try {
    assertKV(env);
    const settings = await getSettings(env);
    if (!settings.scan_enabled) return;

    const sports = settings.alert_filter_sports?.length ? settings.alert_filter_sports : settings.sports || DEFAULT_SETTINGS.sports;
    const markets = settings.alert_filter_markets?.length ? settings.alert_filter_markets : settings.markets || DEFAULT_SETTINGS.markets;
    const today = dateStr();
    let alertCnt = Number(await kv(env).get(`alerts:count:${today}`) || 0);
    const maxDay = Number(settings.max_alerts_per_day || 5);

    for (const sport of sports) {
      if (alertCnt >= maxDay) break;
      for (const market of markets) {
        if (alertCnt >= maxDay) break;
        try {
          const opps = await handleAnalyzeInternal(sport, market, 'quick', env, settings);
          const scored = opps
            .filter(o => (o.score?.total || 0) >= (settings.min_alert_score || 75))
            .filter(o => !o.odds || (o.odds >= (settings.alert_min_odds || 1.4) && o.odds <= (settings.alert_max_odds || 5)))
            .sort((a, b) => (b.score?.total || 0) - (a.score?.total || 0));

          for (const opp of scored.slice(0, 2)) {
            if (alertCnt >= maxDay) break;
            const sent = await sendAlert(env, opp);
            if (sent) {
              alertCnt++;
              await kv(env).put(`alerts:count:${today}`, String(alertCnt), { expirationTtl: 86400 * 2 });
              await sleep(500);
            }
          }
        } catch (err) {
          console.error(`Scheduled scan ${sport}/${market}:`, err.message);
        }
      }
    }
  } catch (err) {
    console.error('Scheduled scan failed:', err.message);
  }
}

function runLiveModel(params) {
  const minute = Number(params.minute || 45);
  const scoreHome = Number(params.scoreHome || 0);
  const scoreAway = Number(params.scoreAway || 0);
  const totalMin = params.extraTime ? 120 : 90;
  const minLeft = Math.max(1, totalMin - minute);
  const fracLeft = minLeft / 90;

  const lambdaHome = Number(params.lambdaHome || 1.4);
  const lambdaAway = Number(params.lambdaAway || 1.1);

  let lH = lambdaHome * fracLeft * (params.redCardHome ? 0.72 : 1) * (params.redCardAway ? 1.12 : 1);
  let lA = lambdaAway * fracLeft * (params.redCardAway ? 0.72 : 1) * (params.redCardHome ? 1.12 : 1);

  const totalShots = Math.max(1, Number(params.homeShots || 0) + Number(params.awayShots || 0));
  const totalCorners = Math.max(1, Number(params.homeCorners || 0) + Number(params.awayCorners || 0));
  const momH = ((Number(params.homeShots || 0) / totalShots) - 0.5) * 0.28 + ((Number(params.homeCorners || 0) / totalCorners) - 0.5) * 0.12;
  const momA = ((Number(params.awayShots || 0) / totalShots) - 0.5) * 0.28 + ((Number(params.awayCorners || 0) / totalCorners) - 0.5) * 0.12;

  lH = Math.max(0.04, lH * (1 + momH));
  lA = Math.max(0.04, lA * (1 + momA));

  const pH = computePoisson(lH);
  const pA = computePoisson(lA);

  let pHW = 0, pD = 0, pAW = 0, p05 = 0, p15 = 0, p25 = 0, p35 = 0, pBTTS = 0;
  const scoreMtx = [];

  for (let h = 0; h <= 7; h++) {
    for (let a = 0; a <= 7; a++) {
      const p = (pH[h] || 0) * (pA[a] || 0);
      const fH = scoreHome + h;
      const fA = scoreAway + a;
      const total = fH + fA;
      if (fH > fA) pHW += p;
      else if (fH === fA) pD += p;
      else pAW += p;
      if (total > 0.5) p05 += p;
      if (total > 1.5) p15 += p;
      if (total > 2.5) p25 += p;
      if (total > 3.5) p35 += p;
      if (fH > 0 && fA > 0) pBTTS += p;
      if (h <= 4 && a <= 4) scoreMtx.push({ h: fH, a: fA, p: Math.round(p * 10000) / 100 });
    }
  }

  scoreMtx.sort((a, b) => b.p - a.p);
  const lH5 = lH * (Math.min(5, minLeft) / minLeft);
  const lA5 = lA * (Math.min(5, minLeft) / minLeft);
  const pNext5 = 1 - Math.exp(-(lH5 + lA5));

  return {
    lambdas: { home: round(lH, 2), away: round(lA, 2) },
    minutes_left: minLeft,
    outcomes: { home_win: pct(pHW), draw: pct(pD), away_win: pct(pAW) },
    totals: { over_05: pct(p05), over_15: pct(p15), over_25: pct(p25), over_35: pct(p35) },
    btts: pct(pBTTS),
    next_goal: {
      within_5min: pct(pNext5),
      home_pct: lH5 + lA5 > 0 ? round((lH5 / (lH5 + lA5)) * 100, 1) : 50,
      away_pct: lH5 + lA5 > 0 ? round((lA5 / (lH5 + lA5)) * 100, 1) : 50,
    },
    top_scores: scoreMtx.slice(0, 6),
    context: {
      late_game: minute >= 70,
      closing: minute >= 80,
      momentum: momH > 0.06 ? 'home' : momA > 0.06 ? 'away' : 'balanced',
      red_card_impact: !!(params.redCardHome || params.redCardAway),
    },
  };
}

function computePoisson(lambda) {
  const probs = [];
  let fact = 1;
  const eL = Math.exp(-lambda);
  for (let k = 0; k <= 8; k++) {
    if (k > 0) fact *= k;
    probs.push(eL * Math.pow(lambda, k) / fact);
  }
  return probs;
}

function detectLiveValue(modelProbs, liveOdds) {
  if (!liveOdds || !modelProbs) return [];
  const checks = [
    { key: 'home_win', prob: modelProbs.outcomes.home_win, label: 'Victoire domicile' },
    { key: 'draw', prob: modelProbs.outcomes.draw, label: 'Match nul' },
    { key: 'away_win', prob: modelProbs.outcomes.away_win, label: 'Victoire extérieur' },
    { key: 'over_15', prob: modelProbs.totals.over_15, label: 'Over 1.5' },
    { key: 'over_25', prob: modelProbs.totals.over_25, label: 'Over 2.5' },
    { key: 'over_35', prob: modelProbs.totals.over_35, label: 'Over 3.5' },
    { key: 'btts', prob: modelProbs.btts, label: 'BTTS Oui' },
  ];
  return checks.flatMap(c => {
    const lo = Number(liveOdds[c.key] || 0);
    if (!lo || c.prob < 5 || c.prob > 97) return [];
    const modelOdds = 100 / c.prob;
    const edge = ((lo / modelOdds) - 1) * 100;
    if (edge <= 2) return [];
    return [{ ...c, model_odds: round(modelOdds, 2), live_odds: lo, edge: round(edge, 1), signal: edge > 8 ? 'FORT' : edge > 4 ? 'MODERE' : 'FAIBLE' }];
  }).sort((a, b) => b.edge - a.edge);
}

function parseJsonLoose(text) {
  if (!text) return null;
  const cleaned = String(text).replace(/```json\s*/gi, '').replace(/```/g, '').trim();
  try { return JSON.parse(cleaned); } catch {}
  const start = cleaned.indexOf('{');
  const end = cleaned.lastIndexOf('}');
  if (start >= 0 && end > start) {
    try { return JSON.parse(cleaned.slice(start, end + 1)); } catch {}
  }
  return null;
}

