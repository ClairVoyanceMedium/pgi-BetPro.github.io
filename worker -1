function calculateScore(opp, settings) {
  const w = settings.scoring_weights || DEFAULT_SETTINGS.scoring_weights;
  const subs = {
    odds_value: calcOddsValue(opp),
    recent_form: calcFormScore(opp),
    h2h_history: calcH2HScore(opp),
    stat_consistency: calcStatScore(opp),
    market_consensus: calcConsensusScore(opp),
    contextual_factors: calcContextScore(opp),
    stability: calcStabilityScore(opp),
    data_freshness: calcFreshnessScore(opp),
  };

  const total = Math.round(
    subs.odds_value * w.odds_value +
    subs.recent_form * w.recent_form +
    subs.h2h_history * w.h2h_history +
    subs.stat_consistency * w.stat_consistency +
    subs.market_consensus * w.market_consensus +
    subs.contextual_factors * w.contextual_factors +
    subs.stability * w.stability +
    subs.data_freshness * w.data_freshness
  );

  const t = clamp(total, 0, 100);
  const betDir = getBetDirection(opp, t);

  return {
    total: t,
    subscores: subs,
    signal: t >= 85 ? 'EXCEPTIONNEL' : t >= 75 ? 'FORT' : t >= 65 ? 'CORRECT' : t >= 50 ? 'FAIBLE' : 'TRES FAIBLE',
    risk_level: t >= 85 ? 'Risque mesuré' : t >= 75 ? 'Risque modéré' : t >= 65 ? 'Risque notable' : 'Risque élevé',
    explanation: buildExplanation(subs, opp),
    goals_prediction: predictGoals(opp),
    ...betDir,
  };
}

function calcOddsValue(opp) {
  const bms = (opp.all_bookmakers || []).map(b => Number(b.odds)).filter(Boolean);
  if (!bms.length) return opp.odds ? 45 : 30;
  const best = Math.max(...bms);
  const avg = bms.reduce((a, b) => a + b, 0) / bms.length;
  const ratio = avg > 0 ? (best - avg) / avg : 0;
  return clamp(Math.round(50 + ratio * 700 + bms.length * 2), 0, 100);
}

function calcFormScore(opp) {
  const m = opp.metadata || {};
  const sel = norm(opp.selection);
  const home = norm(opp.home_team).split(' ')[0];
  const away = norm(opp.away_team).split(' ')[0];

  if (m.home_form_points !== undefined || m.away_form_points !== undefined) {
    if (sel.includes(home)) return clamp(m.home_form_points || 50, 0, 100);
    if (sel.includes(away)) return clamp(m.away_form_points || 50, 0, 100);
    if (sel.includes('over')) return scoreOverUnder(m.est_goals || 2.5, opp.line || 2.5, true);
    if (sel.includes('under')) return scoreOverUnder(m.est_goals || 2.5, opp.line || 2.5, false);
    if (sel.includes('oui') || sel.includes('yes') || sel.includes('marquent')) return clamp(Math.round(m.est_btts_prob || 52), 0, 100);
    if (sel.includes('non') || sel.includes('no')) return clamp(Math.round(100 - (m.est_btts_prob || 52)), 0, 100);
  }

  if (sel.includes('over')) return scoreOverUnder(m.est_goals || inferEstTotal(opp.sport, opp.market), opp.line || 2.5, true);
  if (sel.includes('under')) return scoreOverUnder(m.est_goals || inferEstTotal(opp.sport, opp.market), opp.line || 2.5, false);
  return 55;
}

function scoreOverUnder(est, line, isOver) {
  const diff = isOver ? est - line : line - est;
  return clamp(Math.round(50 + diff * 22), 15, 95);
}

function calcH2HScore(opp) {
  const m = opp.metadata || {};
  if (!m.h2h_total || m.h2h_total < 3) return 50;
  const sel = norm(opp.selection);
  const home = norm(opp.home_team).split(' ')[0];
  const away = norm(opp.away_team).split(' ')[0];
  if (sel.includes(home)) return clamp(Math.round(m.h2h_home_wins / m.h2h_total * 100), 10, 95);
  if (sel.includes(away)) return clamp(Math.round(m.h2h_away_wins / m.h2h_total * 100), 10, 95);
  if (sel.includes('nul') || sel.includes('draw')) return clamp(Math.round(m.h2h_draws / m.h2h_total * 100), 10, 70);
  if (sel.includes('over')) return clamp(Math.round(m.h2h_over25 / m.h2h_total * 100), 10, 95);
  if (sel.includes('under')) return clamp(Math.round((1 - m.h2h_over25 / m.h2h_total) * 100), 10, 95);
  return 55;
}

function calcStatScore(opp) {
  const m = opp.metadata || {};
  const sel = norm(opp.selection);
  const est = m.est_goals || m.est_total || inferEstTotal(opp.sport, opp.market);
  if (sel.includes('over')) return scoreOverUnder(est, opp.line || 2.5, true);
  if (sel.includes('under')) return scoreOverUnder(est, opp.line || 2.5, false);
  if (sel.includes('oui') || sel.includes('yes') || sel.includes('marquent')) return clamp(Math.round(m.est_btts_prob || 52), 15, 92);
  if (sel.includes('non') || sel.includes('no')) return clamp(Math.round(100 - (m.est_btts_prob || 52)), 15, 92);
  return 55;
}

function calcConsensusScore(opp) {
  const bms = (opp.all_bookmakers || []).filter(b => b.odds);
  if (bms.length < 2) return 50;
  const odds = bms.map(b => Number(b.odds));
  const avg = odds.reduce((a, b) => a + b, 0) / odds.length;
  const spread = (Math.max(...odds) - Math.min(...odds)) / avg;
  return clamp(Math.round(100 - spread * 400 + Math.min(20, bms.length * 4)), 20, 100);
}

function calcContextScore(opp) {
  const m = opp.metadata || {};
  let score = 50;
  const sel = norm(opp.selection);
  const home = norm(opp.home_team).split(' ')[0];
  if (m.home_wins_home && m.home_played_home && sel.includes(home)) {
    score += ((m.home_wins_home / m.home_played_home) - 0.4) * 35;
  }
  if (m.home_form_clean_sh >= 3) score += 5;
  if (m.away_form_clean_sh >= 3) score += 5;
  if (m.data_source && m.data_source.includes('api_sports')) score += 5;
  return clamp(Math.round(score), 0, 100);
}

function calcStabilityScore(opp) {
  const bms = (opp.all_bookmakers || []).map(b => Number(b.odds)).filter(Boolean);
  if (bms.length < 2) return 50;
  const avg = bms.reduce((a, b) => a + b, 0) / bms.length;
  const cv = Math.sqrt(bms.reduce((s, b) => s + (b - avg) ** 2, 0) / bms.length) / avg;
  return clamp(Math.round(100 - cv * 600), 15, 100);
}

function calcFreshnessScore(opp) {
  const s = opp.source || '';
  if (s.includes('+')) return 100;
  if (s.includes('odds_api')) return 75;
  if (s.includes('api_football') || s.includes('api_sports')) return 70;
  return 40;
}

function predictGoals(opp) {
  const m = opp.metadata || {};
  const g = Number(m.est_goals || m.est_total || 0);
  if (!g) return null;
  return {
    expected: +g.toFixed(2),
    over_15: clamp(Math.round(95 - Math.exp(-g * 1.2) * 70), 20, 98),
    over_25: clamp(Math.round(80 - Math.exp(-(g - 1.5)) * 60), 10, 92),
    over_35: clamp(Math.round(60 - Math.exp(-(g - 2)) * 55), 5, 80),
    btts: m.est_btts_prob != null ? Math.round(m.est_btts_prob) : null,
  };
}

function buildExplanation(subs, opp) {
  const m = opp.metadata || {};
  const lines = [];
  if (subs.odds_value >= 70) lines.push('Cote supérieure à la moyenne bookmakers.');
  else if (subs.odds_value < 45) lines.push('Valeur de cote faible ou cote indisponible.');
  if (m.home_recent_form) lines.push(`Forme domicile : ${m.home_recent_form} (${m.home_form_points}/100).`);
  if (m.away_recent_form) lines.push(`Forme extérieur : ${m.away_recent_form} (${m.away_form_points}/100).`);
  if (m.h2h_total >= 3) lines.push(`H2H : ${m.h2h_home_wins}V-${m.h2h_draws}N-${m.h2h_away_wins}D sur ${m.h2h_total} matchs.`);
  if (m.est_goals) lines.push(`Estimation total : ${m.est_goals} unités/buts.`);
  if (subs.stability >= 70) lines.push(`Marché stable avec ${(opp.all_bookmakers || []).length} bookmakers.`);
  if (!opp.odds) lines.push('Cote à vérifier manuellement sur le bookmaker.');
  return lines;
}

function getBetDirection(opp, score) {
  const sport = getSportCat(opp.sport);
  const sel = norm(opp.selection);
  const market = opp.market || '';
  const meta = opp.metadata || {};
  const odds = Number(opp.odds || 0);
  const bms = opp.all_bookmakers || [];
  const bestOdds = bms.length ? Math.max(...bms.map(b => Number(b.odds || 0))) : odds;
  const avgOdds = bms.length ? bms.reduce((a, b) => a + Number(b.odds || 0), 0) / bms.length : odds;
  const edge = avgOdds > 0 && bestOdds > 0 ? Math.round((bestOdds / avgOdds - 1) * 1000) / 10 : 0;
  const impliedProb = bestOdds > 0 ? Math.round(1000 / bestOdds) / 10 : 0;

  let direction = score >= 75 ? 'FOR' : score >= 60 ? 'WAIT' : 'SKIP';
  let conseil = score >= 75 ? 'Signal fort, vérifier la cote finale avant décision.' : score >= 60 ? 'Signal moyen, attendre confirmation live.' : 'Valeur insuffisante.';
  let moment = direction === 'FOR' ? 'Avant match ou live si la cote reste correcte' : direction === 'WAIT' ? 'Live uniquement' : 'Ne pas jouer';
  let signal_type = score >= 80 ? 'strong' : 'standard';

  if (sport === 'football') {
    const estGoals = Number(meta.est_goals || 2.45);
    const bttsProb = Number(meta.est_btts_prob || 52);
    if (market === 'totals' && sel.includes('over')) {
      const line = Number(opp.line || 2.5);
      direction = estGoals > line + 0.25 ? 'FOR' : estGoals < line - 0.25 ? 'AGAINST' : 'WAIT';
      conseil = `Moyenne estimée : ${estGoals} vs ligne ${line}.`;
      moment = estGoals > line + 0.45 ? 'Avant le match' : 'Live 0-15 min si match ouvert';
      signal_type = estGoals > line + 0.55 ? 'strong' : 'standard';
    } else if (market === 'totals' && sel.includes('under')) {
      const line = Number(opp.line || 2.5);
      direction = estGoals < line - 0.25 ? 'FOR' : estGoals > line + 0.25 ? 'AGAINST' : 'WAIT';
      conseil = `Moyenne estimée : ${estGoals} vs ligne ${line}.`;
    } else if (market === 'btts') {
      const yes = sel.includes('oui') || sel.includes('yes') || sel.includes('marquent');
      direction = yes ? (bttsProb >= 58 ? 'FOR' : bttsProb <= 42 ? 'AGAINST' : 'WAIT') : (bttsProb <= 42 ? 'FOR' : bttsProb >= 58 ? 'AGAINST' : 'WAIT');
      conseil = `Probabilité BTTS estimée : ${bttsProb}%.`;
    }
  }

  if (sport === 'basketball' && market === 'h2h') {
    direction = odds && odds <= 1.55 ? 'FOR' : odds >= 2.8 ? 'SKIP' : 'WAIT';
    conseil = `Moneyline basket : cote ${odds || 'à vérifier'}. Favoris courts seulement.`;
  }

  if (sport === 'tennis' && market === 'h2h') {
    direction = odds && odds <= 1.55 ? 'FOR' : odds >= 2.5 ? 'WAIT' : direction;
    conseil = `Tennis : cote ${odds || 'à vérifier'}. Vérifier surface, forme et état physique.`;
  }

  const pinBm = [...bms].sort((a, b) => Number(b.odds || 0) - Number(a.odds || 0)).find(b => norm(b.bookmaker).includes('pinnacle'));
  const bookmaker_tip = pinBm ? `Pinnacle : ${pinBm.odds}. Vérifier aussi Piwi 247.` : 'Comparer Piwi 247, Pinnacle et le meilleur bookmaker disponible.';

  return {
    direction,
    conseil,
    moment,
    edge: edge > 0 ? edge : 0,
    implied_prob: impliedProb,
    bookmaker_tip,
    dont_bet_if: direction === 'SKIP' ? 'Signal insuffisant.' : direction === 'WAIT' ? 'Si la cote baisse ou si le rythme live ne confirme pas.' : null,
    signal_type,
  };
}

