function buildOpportunities(fixture, oddsEvent, meta, market, sport, competition) {
  const home = fixture.teams?.home?.name || '?';
  const away = fixture.teams?.away?.name || '?';
  const base = {
    sport,
    competition,
    event_id: `af_${fixture.fixture?.id || crypto.randomUUID()}`,
    home_team: home,
    away_team: away,
    start_time: fixture.fixture?.date || null,
    venue: fixture.fixture?.venue?.name || null,
    metadata: meta,
    source: oddsEvent ? 'api_football+odds_api' : 'api_football',
  };

  const results = [];
  const add = (mkt, sel, line, allBm = []) => {
    const best = allBm.length ? allBm.reduce((a, b) => b.odds > a.odds ? b : a, allBm[0]) : null;
    results.push({ ...base, market: mkt, selection: sel, line, odds: best?.odds || null, bookmaker: best?.bookmaker || (oddsEvent ? 'Odds API' : 'Cote à vérifier'), all_bookmakers: allBm });
  };

  const getOdds = (mktKey, name, point = null) => extractOdds(oddsEvent, mktKey, name, point);
  const wanted = market === 'all' ? ['h2h', 'totals_15', 'totals', 'totals_35', 'btts', 'spreads'] : [market];

  if (wanted.includes('h2h')) {
    add('h2h', home, null, getOdds('h2h', home));
    add('h2h', 'Nul', null, getOdds('h2h', 'Draw'));
    add('h2h', away, null, getOdds('h2h', away));
  }
  if (wanted.includes('double_chance')) {
    add('double_chance', `${home}/Nul`, null, []);
    add('double_chance', `${away}/Nul`, null, []);
    add('double_chance', `${home}/${away}`, null, []);
  }
  if (wanted.includes('draw_no_bet')) {
    add('draw_no_bet', `DNB: ${home}`, null, []);
    add('draw_no_bet', `DNB: ${away}`, null, []);
  }
  for (const item of wanted) {
    if (['totals_15', 'totals', 'totals_35', 'totals_45'].includes(item)) {
      const line = item === 'totals_15' ? 1.5 : item === 'totals_35' ? 3.5 : item === 'totals_45' ? 4.5 : 2.5;
      add('totals', `Over ${line}`, line, getOdds('totals', 'Over', line));
      add('totals', `Under ${line}`, line, getOdds('totals', 'Under', line));
    }
  }
  if (wanted.includes('btts')) {
    add('btts', 'Les deux équipes marquent — Oui', null, getOdds('btts', 'Yes'));
    add('btts', 'Les deux équipes marquent — Non', null, getOdds('btts', 'No'));
  }
  if (wanted.includes('spreads')) {
    const lines = collectSpreadLines(oddsEvent).slice(0, 3);
    for (const l of lines) {
      add('spreads', `HC ${home} ${l > 0 ? '+' + l : l}`, l, getOdds('spreads', home, l));
      add('spreads', `HC ${away} ${l > 0 ? '+' + l : l}`, l, getOdds('spreads', away, l));
    }
  }

  return dedupeOpps(results);
}

function buildMultiSportOpportunities({ sport, competition, event_id, home_team, away_team, start_time, oddsEvent, meta, market, sp }) {
  const opps = [];
  const add = (mkt, sel, line, allBm = []) => {
    const best = allBm.length ? allBm.reduce((a, b) => b.odds > a.odds ? b : a, allBm[0]) : null;
    opps.push({
      sport,
      competition,
      event_id: event_id || `ms_${crypto.randomUUID()}`,
      home_team,
      away_team,
      start_time,
      market: mkt,
      selection: sel,
      line,
      odds: best?.odds || null,
      bookmaker: best?.bookmaker || (oddsEvent ? 'Odds API' : 'Cote à vérifier'),
      all_bookmakers: allBm,
      source: oddsEvent ? 'api_sports+odds_api' : 'api_sports',
      metadata: meta,
    });
  };

  const getOdds = (mktKey, name, point = null) => extractOdds(oddsEvent, mktKey, name, point);
  const wanted = market === 'all' ? ['h2h', 'totals', 'spreads'] : [market];
  const noDrawSports = ['basketball', 'baseball', 'hockey', 'nfl', 'afl', 'mma'];

  if (wanted.includes('h2h')) {
    add('h2h', home_team, null, getOdds('h2h', home_team));
    if (!noDrawSports.includes(sp)) add('h2h', 'Nul', null, getOdds('h2h', 'Draw'));
    add('h2h', away_team, null, getOdds('h2h', away_team));
  }

  if (wanted.includes('totals')) {
    let lines = collectTotalLines(oddsEvent).slice(0, 4);
    if (!lines.length && meta.est_total) lines = [meta.est_total - 2.5, meta.est_total - 0.5, meta.est_total + 1.5].map(v => Math.round(v * 2) / 2);
    for (const line of lines.filter(Boolean)) {
      add('totals', `Over ${line}`, line, getOdds('totals', 'Over', line));
      add('totals', `Under ${line}`, line, getOdds('totals', 'Under', line));
    }
  }

  if (wanted.includes('spreads')) {
    for (const line of collectSpreadLines(oddsEvent).slice(0, 3)) {
      add('spreads', `HC ${home_team} ${line > 0 ? '+' + line : line}`, line, getOdds('spreads', home_team, line));
      add('spreads', `HC ${away_team} ${line > 0 ? '+' + line : line}`, line, getOdds('spreads', away_team, line));
    }
  }

  return dedupeOpps(opps);
}

function extractOdds(oddsEvent, mktKey, name, point = null) {
  if (!oddsEvent?.bookmakers) return [];
  return oddsEvent.bookmakers.flatMap(bm => {
    const m = bm.markets?.find(mx => mx.key === mktKey);
    if (!m) return [];
    const n1 = norm(name);
    const o = m.outcomes.find(ox => {
      const sameName = norm(ox.name) === n1 || norm(ox.name).includes(n1) || n1.includes(norm(ox.name));
      const samePoint = point === null || Math.abs((ox.point || 0) - point) < 0.3;
      return sameName && samePoint;
    });
    return o ? [{ bookmaker: bm.title, odds: o.price }] : [];
  });
}

function collectTotalLines(oddsEvent) {
  return unique((oddsEvent?.bookmakers || []).flatMap(bm => bm.markets?.find(m => m.key === 'totals')?.outcomes?.map(o => o.point).filter(v => v !== undefined) || [])).sort((a, b) => a - b);
}

function collectSpreadLines(oddsEvent) {
  return unique((oddsEvent?.bookmakers || []).flatMap(bm => bm.markets?.find(m => m.key === 'spreads')?.outcomes?.map(o => o.point).filter(v => v !== undefined) || [])).sort((a, b) => Math.abs(a) - Math.abs(b));
}

