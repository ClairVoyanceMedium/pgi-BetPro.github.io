}

function buildMeta(hStats, aStats, h2h, hForm, aForm, homeName, awayName) {
  const meta = {};

  if (hStats) {
    meta.home_form_str = hStats.form?.slice(-8) || null;
    meta.home_wins_home = hStats.fixtures?.wins?.home || 0;
    meta.home_played_home = hStats.fixtures?.played?.home || 1;
    meta.home_goals_for = parseFloat(hStats.goals?.for?.average?.home || 1.3);
    meta.home_goals_ag = parseFloat(hStats.goals?.against?.average?.home || 1.1);
    meta.home_cs_home = hStats.clean_sheet?.home || 0;
    meta.home_failed_home = hStats.failed_to_score?.home || 0;
  }

  if (aStats) {
    meta.away_form_str = aStats.form?.slice(-8) || null;
    meta.away_wins_away = aStats.fixtures?.wins?.away || 0;
    meta.away_played_away = aStats.fixtures?.played?.away || 1;
    meta.away_goals_for = parseFloat(aStats.goals?.for?.average?.away || 1.1);
    meta.away_goals_ag = parseFloat(aStats.goals?.against?.average?.away || 1.3);
    meta.away_cs_away = aStats.clean_sheet?.away || 0;
    meta.away_failed_away = aStats.failed_to_score?.away || 0;
  }

  if (Array.isArray(h2h) && h2h.length) {
    const last = h2h.slice(0, 6);
    let hW = 0, aW = 0, dr = 0, totGoals = 0, over25 = 0, btts = 0;

    for (const m of last) {
      const hs = m.goals?.home || 0;
      const as = m.goals?.away || 0;
      const homeIsHome = m.teams?.home?.name === homeName;
      const homeGoals = homeIsHome ? hs : as;
      const awayGoals = homeIsHome ? as : hs;
      if (homeGoals > awayGoals) hW++;
      else if (homeGoals < awayGoals) aW++;
      else dr++;
      totGoals += hs + as;
      if (hs + as > 2.5) over25++;
      if (hs > 0 && as > 0) btts++;
    }

    meta.h2h_home_wins = hW;
    meta.h2h_away_wins = aW;
    meta.h2h_draws = dr;
    meta.h2h_total = last.length;
    meta.h2h_avg_goals = +(totGoals / last.length).toFixed(2);
    meta.h2h_over25 = over25;
    meta.h2h_btts = btts;
  }

  if (Array.isArray(hForm) && hForm.length) {
    const wf = computeWeightedForm(hForm, homeName);
    meta.home_recent_form = wf.formStr;
    meta.home_form_points = wf.points;
    meta.home_form_goals_for = wf.goalsFor;
    meta.home_form_goals_ag = wf.goalsAg;
    meta.home_form_clean_sh = wf.cleanSheets;
  }

  if (Array.isArray(aForm) && aForm.length) {
    const wf = computeWeightedForm(aForm, awayName);
    meta.away_recent_form = wf.formStr;
    meta.away_form_points = wf.points;
    meta.away_form_goals_for = wf.goalsFor;
    meta.away_form_goals_ag = wf.goalsAg;
    meta.away_form_clean_sh = wf.cleanSheets;
  }

  if (meta.home_goals_for && meta.away_goals_for) {
    meta.est_goals = +((meta.home_goals_for + meta.away_goals_for + meta.home_goals_ag + meta.away_goals_ag) / 2).toFixed(2);
  } else if (meta.h2h_avg_goals) {
    meta.est_goals = meta.h2h_avg_goals;
  } else {
    meta.est_goals = 2.45;
  }

  if (meta.home_goals_for && meta.away_goals_for) {
    const hScores = 1 - Math.exp(-meta.home_goals_for);
    const aScores = 1 - Math.exp(-meta.away_goals_for);
    meta.est_btts_prob = +(hScores * aScores * 100).toFixed(1);
  } else {
    meta.est_btts_prob = 52;
  }

  return meta;
}

function computeWeightedForm(fixtures, teamName) {
  let pts = 0, maxPts = 0, formStr = '', gFor = 0, gAg = 0, cs = 0;
  const weights = [1.5, 1.4, 1.3, 1.2, 1.1, 1, 0.9, 0.8];
  const used = fixtures.slice(0, 8);

  used.forEach((f, i) => {
    const w = weights[i] || 0.8;
    const isHome = f.teams?.home?.name === teamName;
    const gs = isHome ? (f.goals?.home || 0) : (f.goals?.away || 0);
    const ga = isHome ? (f.goals?.away || 0) : (f.goals?.home || 0);
    gFor += gs;
    gAg += ga;
    if (ga === 0) cs++;
    if (gs > ga) { pts += 3 * w; formStr += 'V'; }
    else if (gs === ga) { pts += w; formStr += 'N'; }
    else formStr += 'D';
    maxPts += 3 * w;
  });

  const n = Math.max(1, used.length);
  return {
    formStr,
    points: maxPts > 0 ? Math.round(pts / maxPts * 100) : 50,
    goalsFor: +(gFor / n).toFixed(2),
    goalsAg: +(gAg / n).toFixed(2),
    cleanSheets: cs,
  };
}

