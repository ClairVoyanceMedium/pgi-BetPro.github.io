async function callAI(env, messages, systemPrompt, opts = {}) {
  const key = env.AI_API_KEY;
  if (!key) throw new Error('AI_API_KEY non configurée');

  const provider = (env.AI_PROVIDER || 'groq').toLowerCase().trim();
  const cfg = AI_DEFAULTS[provider] || AI_DEFAULTS.groq;
  const model = env.AI_MODEL || cfg.model;
  const maxTok = opts.maxTokens || 2000;

  if (cfg.format === 'openai') return callOpenAICompatible(key, cfg.url, model, provider, systemPrompt, messages, maxTok);
  if (cfg.format === 'gemini') return callGemini(key, model, systemPrompt, messages, maxTok);
  if (cfg.format === 'anthropic') return callAnthropic(key, model, systemPrompt, messages, maxTok);
  throw new Error('Format IA inconnu : ' + cfg.format);
}

async function callOpenAICompatible(key, url, model, provider, system, messages, maxTok) {
  const headers = { 'Content-Type': 'application/json', Authorization: 'Bearer ' + key };
  if (provider === 'openrouter') {
    headers['HTTP-Referer'] = 'https://pgi-betpro.github.io';
    headers['X-Title'] = 'PGI BetPro';
  }

  const r = await fetch(url, {
    method: 'POST',
    headers,
    body: JSON.stringify({ model, max_tokens: maxTok, temperature: 0.45, messages: [{ role: 'system', content: system }, ...messages] }),
  });
  if (!r.ok) throw new Error(`${provider} HTTP ${r.status}: ${(await r.text()).slice(0, 250)}`);
  return (await r.json()).choices?.[0]?.message?.content || '';
}

async function callGemini(key, model, system, messages, maxTok) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`;
  const contents = messages.map((m, i) => ({
    role: m.role === 'assistant' ? 'model' : 'user',
    parts: [{ text: i === 0 && m.role === 'user' ? system + '\n\n' + m.content : m.content }],
  }));
  const r = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ contents, generationConfig: { maxOutputTokens: maxTok, temperature: 0.45 } }),
  });
  if (!r.ok) throw new Error(`Gemini HTTP ${r.status}: ${(await r.text()).slice(0, 250)}`);
  return (await r.json()).candidates?.[0]?.content?.parts?.[0]?.text || '';
}

async function callAnthropic(key, model, system, messages, maxTok) {
  const r = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01' },
