async function handleChat(req, env) {
  let body;
  try { body = await req.json(); } catch { return json(env, { error: 'JSON invalide' }, 400); }
  const messages = Array.isArray(body.messages) ? body.messages.slice(-10) : [];
  if (!messages.length) return json(env, { error: 'Aucun message' }, 400);

  let ctx = '';
  const c = body.context || {};
  if (c.home && c.away) ctx += `Match : ${c.home} vs ${c.away}. `;
  if (c.score_home !== undefined) ctx += `Score : ${c.score_home}-${c.score_away}. `;
  if (c.minute) ctx += `Minute : ${c.minute}. `;
  if (c.competition) ctx += `Compétition : ${c.competition}. `;
  if (c.extra) ctx += `Infos : ${c.extra}. `;

  try {
    const response = await callAI(env, messages, EXPERT_SYS + (ctx ? '\nContexte : ' + ctx : ''), { maxTokens: 1600 });
    const info = aiInfo(env);
    return json(env, { response, provider: info.provider, model: info.model, at: new Date().toISOString() });
  } catch (err) {
    return json(env, { error: err.message, hint: 'Configurez AI_PROVIDER et AI_API_KEY.' }, 502);
  }
}

