async function callAIVision(env, b64, mime, prompt, system) {
  const key = env.AI_API_KEY;
  if (!key) throw new Error('AI_API_KEY non configurée');

  const provider = (env.AI_PROVIDER || 'groq').toLowerCase().trim();

  if (provider === 'gemini') {
    const model = env.AI_MODEL || 'gemini-1.5-flash';
    const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ inline_data: { mime_type: mime, data: b64 } }, { text: system + '\n\n' + prompt }] }],
        generationConfig: { maxOutputTokens: 2600, temperature: 0.25 },
      }),
    });
    if (!r.ok) throw new Error(`Gemini vision HTTP ${r.status}: ${(await r.text()).slice(0, 180)}`);
    return (await r.json()).candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  if (provider === 'anthropic') {
    const model = env.AI_MODEL || 'claude-sonnet-4-20250514';
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-key': key, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model,
        max_tokens: 2600,
        system,
        messages: [{ role: 'user', content: [{ type: 'image', source: { type: 'base64', media_type: mime, data: b64 } }, { type: 'text', text: prompt }] }],
      }),
    });
    if (!r.ok) throw new Error(`Anthropic vision HTTP ${r.status}: ${(await r.text()).slice(0, 180)}`);
    return (await r.json()).content?.[0]?.text || '';
  }

  throw new Error('Analyse image non supportée avec ce fournisseur. Utilisez AI_PROVIDER=gemini ou anthropic.');
}

