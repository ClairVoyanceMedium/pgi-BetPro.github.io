export default {
  async fetch(req, env, ctx) {
    if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: corsHeaders(env) });

    const url = new URL(req.url);
    const p = url.pathname;

    if (p === '/' || p === '/ping' || p === '/api/ping') {
      return json(env, { ok: true, app: 'PGI BetPro Worker', version: '3.0', at: new Date().toISOString() });
    }

    if (p === '/api/auth' && req.method === 'POST') return handleAuthPublic(req, env);

    if (!checkAuth(req, env)) return json(env, { error: 'Non autorisé' }, 401);

    try {
      assertKV(env);

      if (p === '/api/analyze' && req.method === 'GET') return handleAnalyze(req, env, url);
      if (p === '/api/analyze-match' && req.method === 'POST') return handleAnalyzeMatch(req, env);
      if (p === '/api/live' && req.method === 'GET') return handleLive(env);
      if (p === '/api/leagues' && req.method === 'GET') return json(env, { leagues: FOOTBALL_LEAGUES, markets: MARKETS_DEF });
      if (p === '/api/results' && req.method === 'GET') return json(env, await kv(env).get('latest_results', 'json') || { opportunities: [] });
      if (p === '/api/history' && req.method === 'GET') return handleHistory(env, url);
      if (p === '/api/quotas' && req.method === 'GET') return json(env, await getQuotas(env));
      if (p === '/api/settings' && req.method === 'GET') return json(env, await getSettings(env));
      if (p === '/api/settings' && req.method === 'POST') return handleSaveSettings(req, env);
      if (p === '/api/test-alert' && req.method === 'POST') return handleTestAlert(env);
      if (p === '/api/ai-info' && req.method === 'GET') return json(env, aiInfo(env));
      if (p === '/api/chat' && req.method === 'POST') return handleChat(req, env);
      if (p === '/api/strategy' && req.method === 'POST') return handleStrategy(req, env);
      if (p === '/api/live-scan' && req.method === 'GET') return handleLiveScan(req, env);
      if (p === '/api/live-analysis' && req.method === 'POST') return handleLiveAnalysis(req, env);
      if (p === '/api/live-analysis' && req.method === 'GET') return handleLiveMatchAnalysis(req, env, url);

      return json(env, { error: 'Route introuvable', path: p }, 404);
    } catch (err) {
      console.error('Worker error:', err);
      return json(env, { error: 'Erreur interne', detail: err.message }, 500);
    }
  },

  async scheduled(event, env, ctx) {
    ctx.waitUntil(runScheduledScan(env));
  },
};

function corsHeaders(env) {
  return {
    'Access-Control-Allow-Origin': env.CORS_ORIGIN || DEFAULT_CORS_ORIGIN,
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  };
}

function json(env, data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...corsHeaders(env), 'Content-Type': 'application/json;charset=utf-8' },
  });
}

function kv(env) {
  return env.BETTING_KV;
}

function assertKV(env) {
  if (!env.BETTING_KV) throw new Error('Binding KV manquant : créez un KV et liez-le avec le nom BETTING_KV');
}

async function handleAuthPublic(req, env) {
  let body;
  try { body = await req.json(); } catch { return json(env, { error: 'JSON invalide' }, 400); }
  if (!env.AUTH_PASSWORD) return json(env, { error: 'AUTH_PASSWORD non configuré' }, 500);
  if (body.password === env.AUTH_PASSWORD) return json(env, { ok: true, token: env.AUTH_PASSWORD });
  return json(env, { error: 'Mot de passe incorrect' }, 401);
}

function checkAuth(req, env) {
  if (!env.AUTH_PASSWORD) return false;
  const h = req.headers.get('Authorization') || '';
  return h.replace(/^Bearer\s+/i, '').trim() === env.AUTH_PASSWORD;
}

async function handleAnalyze(req, env, url) {
  const sport = url.searchParams.get('sport') || 'soccer_epl';
  const market = url.searchParams.get('market') || 'h2h';
  const mode = url.searchParams.get('mode') || 'quick';
  const settings = await getSettings(env);
  const quotas = await getQuotas(env);

  const cacheKey = `cache:v3:analyze:${sport}:${market}:${mode}:${dateStr()}`;
  if (mode === 'quick') {
    const cached = await kv(env).get(cacheKey, 'json');
    if (cached) return json(env, { opportunities: cached, source: 'cache', cached: true, analyzed_at: new Date().toISOString() });
  }

  let opps = [];
  let source = 'unknown';
  let warning = null;

  try {
    const cfg = getApiSportsConfig(sport);
    if (cfg && env.API_FOOTBALL_KEY && quotas.api_football_today < 95) {
      if (cfg.sport === 'football') {
        opps = await analyzeFootball(sport, market, mode, env, settings);
        source = 'api_sports_football';
      } else {
        opps = await analyzeMultiSport(sport, market, mode, env, settings, cfg);
        source = `api_sports_${cfg.sport}`;
      }
    } else {
      opps = await analyzeOddsApi(sport, market, env);
      source = 'odds_api';
      if (cfg && quotas.api_football_today >= 95) warning = 'Quota API-Sports presque atteint : fallback Odds API.';
    }
  } catch (err) {
    try {
      opps = await analyzeOddsApi(sport, market, env);
      source = 'odds_api_fallback';
      warning = `Source primaire indisponible (${err.message}) : fallback Odds API.`;
    } catch (err2) {
      return json(env, { error: 'Toutes les sources ont échoué', detail: err2.message }, 502);
    }
  }

  const scored = opps
    .map(o => ({ ...o, score: calculateScore(o, settings) }))
    .filter(o => (o.score?.total || 0) >= 25)
    .sort((a, b) => (b.score?.total || 0) - (a.score?.total || 0))
    .slice(0, 40);

  await kv(env).put(cacheKey, JSON.stringify(scored), { expirationTtl: 3600 });
  await kv(env).put('latest_results', JSON.stringify({ sport, market, mode, source, opportunities: scored, analyzed_at: new Date().toISOString() }), { expirationTtl: 86400 });

  return json(env, { opportunities: scored, source, cached: false, warning, analyzed_at: new Date().toISOString() });
}

async function analyzeFootball(sport, market, mode, env, settings) {
  const cfg = getApiSportsConfig(sport);
  const league = FOOTBALL_LEAGUES[sport];

  if (!cfg && !league) return analyzeOddsApi(sport, market, env);
  if (!env.API_FOOTBALL_KEY) return analyzeOddsApi(sport, market, env);

  const BASE = cfg ? cfg.base : 'https://v3.football.api-sports.io';
  const leagueId = cfg ? cfg.league_id : league.id;
  const leagueSeason = cfg ? cfg.season : league.season;
  const leagueName = FOOTBALL_LEAGUES[sport]?.name || league?.name || sport;
  const headers = { 'x-apisports-key': env.API_FOOTBALL_KEY };

  const fixKey = `cache:v3:fixtures:${sport}:${dateStr()}`;
  let fixtures = await kv(env).get(fixKey, 'json');

  if (!fixtures) {
    const endpoint = `${BASE}/fixtures?league=${encodeURIComponent(leagueId)}&season=${encodeURIComponent(leagueSeason)}&from=${dateStr()}&to=${dateStr(4)}&status=NS`;
    const r = await fetch(endpoint, { headers });
    await incQuota(env, 'api_football');
    if (!r.ok) throw new Error(`API-Football fixtures HTTP ${r.status}`);
    const d = await r.json();
    fixtures = d.response || [];
    await kv(env).put(fixKey, JSON.stringify(fixtures), { expirationTtl: 7200 });
  }

  if (!fixtures.length) return [];

  let oddsMap = {};
  try {
    const oddsKey = ODDS_SPORT_MAP[sport] || sport;
    const ev = await fetchOddsApiRaw(oddsKey, 'h2h,totals,spreads', env);
    for (const e of ev) oddsMap[matchKey(e.home_team, e.away_team)] = e;
  } catch (_) {}

  const maxF = mode === 'deep' ? 10 : 6;
  const opps = [];

  for (const f of fixtures.slice(0, maxF)) {
    const home = f.teams?.home;
    const away = f.teams?.away;
    if (!home?.name || !away?.name) continue;

    let hStats = null, aStats = null, h2hData = null, homeForm = null, awayForm = null;

    if (mode === 'deep' || mode === 'expert') {
      [hStats, aStats, h2hData, homeForm, awayForm] = await Promise.all([
        fetchTeamStats(env, home.id, leagueId, leagueSeason, BASE, headers),
        fetchTeamStats(env, away.id, leagueId, leagueSeason, BASE, headers),
        fetchH2H(env, home.id, away.id, BASE, headers),
        fetchTeamForm(env, home.id, BASE, headers),
        fetchTeamForm(env, away.id, BASE, headers),
      ]);
    } else {
      [homeForm, awayForm] = await Promise.all([
        fetchTeamForm(env, home.id, BASE, headers),
        fetchTeamForm(env, away.id, BASE, headers),
      ]);
    }

    const oddsEvent = findOddsEvent(oddsMap, home.name, away.name);
