  } catch { return null; }
}

async function searchFixture(env, home, away, date) {
  if (!env.API_FOOTBALL_KEY) return null;
  const d = date ? String(date).split('T')[0] : dateStr();
  try {
    const r = await fetch(`https://v3.football.api-sports.io/fixtures?date=${d}&search=${encodeURIComponent(home)}`, {
      headers: { 'x-apisports-key': env.API_FOOTBALL_KEY },
    });
    await incQuota(env, 'api_football');
    if (!r.ok) return null;
    const data = await r.json();
    const candidates = data.response || [];
    return candidates.find(f => norm(f.teams?.home?.name).includes(norm(home).split(' ')[0]) && norm(f.teams?.away?.name).includes(norm(away).split(' ')[0])) || candidates[0] || null;
  } catch { return null; }
}

async function fetchApiSportsFixtures(env, sportKey, daysAhead = 4) {
  const cfg = getApiSportsConfig(sportKey);
  if (!cfg || !env.API_FOOTBALL_KEY) return [];

  const cacheKey = `cache:v3:apisports:${sportKey}:${dateStr()}`;
  const cached = await kv(env).get(cacheKey, 'json');
  if (cached) return cached;

  const endpoint = cfg.sport === 'football' ? 'fixtures' : cfg.sport === 'mma' ? 'events' : 'games';
  const params = new URLSearchParams({ league: cfg.league_id, season: cfg.season, from: dateStr(), to: dateStr(daysAhead) }).toString();

  try {
    const r = await fetch(`${cfg.base}/${endpoint}?${params}`, { headers: { 'x-apisports-key': env.API_FOOTBALL_KEY } });
    await incQuota(env, 'api_football');
    if (!r.ok) return [];
    const d = await r.json();
    const data = d.response || [];
    if (data.length) await kv(env).put(cacheKey, JSON.stringify(data), { expirationTtl: 7200 });
    return data;
  } catch { return []; }
}

function normalizeApiSportsFixture(raw, sportKey) {
  const cfg = getApiSportsConfig(sportKey);
  if (!cfg) return null;

  if (cfg.sport === 'football') {
    return {
      event_id: `afs_${raw.fixture?.id}`,
      home_team: raw.teams?.home?.name || '?',
      away_team: raw.teams?.away?.name || '?',
      competition: raw.league?.name || '',
      start_time: raw.fixture?.date || null,
      sport: sportKey,
