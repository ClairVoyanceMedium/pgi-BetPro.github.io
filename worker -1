  const opps = [];

  for (const ev of events) {
    for (const bm of ev.bookmakers || []) {
      for (const m of bm.markets || []) {
        for (const o of m.outcomes || []) {
          const allBm = (ev.bookmakers || []).flatMap(b2 => {
            const m2 = b2.markets?.find(mx => mx.key === m.key);
            if (!m2) return [];
            const o2 = m2.outcomes.find(ox => ox.name === o.name && (o.point === undefined || Math.abs((ox.point || 0) - (o.point || 0)) < 0.15));
            return o2 ? [{ bookmaker: b2.title, odds: o2.price }] : [];
          });
          if (!allBm.length) continue;
          const best = allBm.reduce((a, b) => b.odds > a.odds ? b : a, allBm[0]);
          opps.push({
            sport,
            competition: fmtSport(sport),
            event_id: ev.id,
            home_team: ev.home_team,
            away_team: ev.away_team,
            start_time: ev.commence_time,
            market: m.key,
            selection: o.point !== undefined ? `${o.name} ${o.point}` : o.name,
            line: o.point ?? null,
            odds: best.odds,
            bookmaker: best.bookmaker,
            source: 'odds_api',
            all_bookmakers: allBm,
            metadata: { data_source: 'odds_api_only', est_goals: inferEstTotal(sport, m.key), est_btts_prob: 52 },
          });
        }
      }
    }
  }

  return dedupeOpps(opps);
}

