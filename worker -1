function findOddsEvent(oddsMap, home, away) {
  const targetHome = norm(home);
  const targetAway = norm(away);
  const targetHomeFirst = targetHome.split(' ')[0];
  const targetAwayFirst = targetAway.split(' ')[0];
  for (const [k, ev] of Object.entries(oddsMap || {})) {
    const [h, a] = k.split('||');
    const okHome = h.includes(targetHomeFirst) || targetHome.includes(h.split(' ')[0]);
    const okAway = a.includes(targetAwayFirst) || targetAway.includes(a.split(' ')[0]);
    if (okHome || okAway) return ev;
  }
  return null;
}

function matchKey(home, away) {
  return `${norm(home)}||${norm(away)}`;
}

function dedupeOpps(opps) {
  const seen = new Set();
  const out = [];
  for (const o of opps) {
    const k = `${o.event_id}|${o.market}|${o.selection}|${o.line ?? ''}`;
    if (seen.has(k)) continue;
    seen.add(k);
    out.push(o);
  }
  return out;
}

function unique(arr) {
  return [...new Set(arr.filter(v => v !== undefined && v !== null))];
}

function dateStr(off = 0) {
  const d = new Date();
  d.setDate(d.getDate() + off);
  return d.toISOString().split('T')[0];
}

function clamp(v, a, b) {
  return Math.max(a, Math.min(b, Number(v) || 0));
}

function norm(s) {
  return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
}

function sleep(ms) {
  return new Promise(r => setTimeout(r, ms));
}

function round(v, n = 2) {
  const p = 10 ** n;
  return Math.round(Number(v || 0) * p) / p;
}

function pct(v) {
  return round(Number(v || 0) * 100, 1);
}

function safeKey(s) {
  return norm(s).replace(/\s+/g, '_');
}

function escapeHtml(s) {
  return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function fmtSport(s) {
  return String(s || '').replace('soccer_', 'Football ').replace('basketball_', 'Basketball ').replace('tennis_', 'Tennis ').replace('icehockey_', 'Hockey ').replace('baseball_', 'Baseball ').replace('americanfootball_', 'NFL ').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
